# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.venv/
venv/

# Credenciais (nunca commitar)
credentials/
!src/classificacao_procons/credentials/
!src/classificacao_procons/credentials/*.py
*.json
!pyproject.toml
!.cursor/environment.json
!docs/migration/monday-sunday-ledger.json

# Downloads locais
downloads/
data/
logs/

.idea/
.vscode/

# cursor-chatgpt-bridge (Node/TypeScript subproject; needs its own *.json and
# data/ semantics, overriding the broader Python-repo rules above).
!cursor-chatgpt-bridge/**/*.json
!cursor-chatgpt-bridge/data/
cursor-chatgpt-bridge/data/*.db
cursor-chatgpt-bridge/data/*.db-*
!cursor-chatgpt-bridge/data/.gitkeep
cursor-chatgpt-bridge/node_modules/
cursor-chatgpt-bridge/dist/
cursor-chatgpt-bridge/.env
