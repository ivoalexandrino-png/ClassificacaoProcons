# HTTP port for the MCP server (Streamable HTTP transport + /health).
PORT=3000

# Bearer token that callers (ChatGPT's MCP connector) must send as:
#   Authorization: Bearer <CURSOR_BRIDGE_TOKEN>
# Required. The server refuses to start without it (except in test mode).
CURSOR_BRIDGE_TOKEN=

# Cursor API key (user or service-account) used by @cursor/sdk to create/resume
# Cursor Agents. See https://cursor.com/dashboard/api
CURSOR_API_KEY=

# Path to the SQLite database file used to persist projects/agents/runs/messages.
DATABASE_PATH=./data/bridge.db

# Max time (ms) cursor_send_followup will wait for a run to finish before
# reporting status "timeout" (the run keeps executing on Cursor's side).
CURSOR_RUN_TIMEOUT_MS=900000

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info
