PORT=3000
HOST=0.0.0.0

# Required: Bearer token for MCP/HTTP clients (ChatGPT connector auth)
CURSOR_BRIDGE_TOKEN=

# Required for real Cursor Agent calls (https://cursor.com/dashboard/api)
CURSOR_API_KEY=

# SQLite database path (created automatically)
DATABASE_PATH=./data/bridge.db

# Max wait for wait_for_completion=true (default 15 minutes)
CURSOR_RUN_TIMEOUT_MS=900000

# Default model for new agents
CURSOR_DEFAULT_MODEL=composer-2.5

# Comma-separated Host values allowed for MCP (DNS rebinding protection).
# Include your public tunnel hostname in production, e.g. bridge.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

LOG_LEVEL=info
