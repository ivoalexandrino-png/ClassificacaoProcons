# ---- Bridge server ----
# Port the HTTP (remote MCP) transport listens on.
PORT=3000
# Bind address. Use 0.0.0.0 in containers.
HOST=0.0.0.0
# Transport to start: "http" (remote, for ChatGPT) or "stdio" (local clients).
MCP_TRANSPORT=http

# ---- Security (REQUIRED for the HTTP transport) ----
# Bearer token every request must present: "Authorization: Bearer <token>".
# The server refuses all MCP requests until this is set. Generate a strong random value.
CURSOR_BRIDGE_TOKEN=

# ---- Cursor SDK ----
# API key for the official @cursor/sdk (https://cursor.com/dashboard/api).
# Without it, read-only bridge tools still work but agent actions return CURSOR_API_ERROR.
CURSOR_API_KEY=
# Default model id used when starting agents (e.g. auto, composer-2.5).
CURSOR_MODEL=auto
# Max time (ms) to wait for a run before recording a timeout (default 15 min).
CURSOR_RUN_TIMEOUT_MS=900000

# ---- Persistence ----
# SQLite database file for bridge persistence (projects/agents/runs/messages).
DATABASE_PATH=./data/bridge.db
# Directory for the Cursor SDK local agent store (JSONL) used to resume local agents.
CURSOR_LOCAL_STORE_PATH=./data/cursor-local-store

# ---- Logging ----
# One of: debug, info, warn, error.
LOG_LEVEL=info
