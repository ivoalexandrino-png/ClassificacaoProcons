PORT=3000
HOST=0.0.0.0

# Generate at least 32 random bytes, for example: openssl rand -hex 32
CURSOR_BRIDGE_TOKEN=

# Cursor user or service-account API key. Team Admin keys are not supported.
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

DATABASE_PATH=./data/bridge.db
CURSOR_RUN_TIMEOUT_MS=900000
MAX_DIFF_CHARS=30000
LOG_LEVEL=info
