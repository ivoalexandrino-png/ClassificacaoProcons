# HTTP port for the MCP server and health check
PORT=3000

# REQUIRED for HTTP mode: shared secret that MCP clients (ChatGPT) must send as
#   Authorization: Bearer <CURSOR_BRIDGE_TOKEN>
# Generate one with: openssl rand -hex 32
CURSOR_BRIDGE_TOKEN=

# REQUIRED to talk to Cursor: user API key from https://cursor.com/dashboard/api
# (or a service-account key). Used by the official @cursor/sdk.
CURSOR_API_KEY=

# SQLite database file (created automatically)
DATABASE_PATH=./data/bridge.db

# Max time to wait for a Cursor run when wait_for_completion=true (default 15 min).
# On timeout the run is recorded as "timeout" and stays queryable via cursor_get_run.
CURSOR_RUN_TIMEOUT_MS=900000

# debug | info | warn | error
LOG_LEVEL=info

# Default cap for diffs returned by cursor_get_changes (characters)
MAX_DIFF_CHARS=30000
